# mainnet | testnet
ARC_NETWORK=testnet
# ARC_RPC_URL=https://rpc.testnet.arc.io
VAULT_ADDRESS=0x...
# Key of the address set as `agent` in the vault. Keep only a little USDC on it for gas.
AGENT_PRIVATE_KEY=0x...
# Block the vault was deployed at (speeds up the first sync)
START_BLOCK=0

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# LLM_BASE_URL=   # for OpenAI-compatible providers (LLM_PROVIDER=openai)

PORT=8787
PUBLISH_PROMPT=true
MAX_MESSAGE_CHARS=1000
DB_PATH=./data/heist.sqlite
STATIC_DIR=../frontend/dist
